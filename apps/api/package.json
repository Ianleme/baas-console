{
  "name": "@baas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/main.js",
    "test:integration": "node ../../scripts/run-mysql-integration.mjs",
    "test:integration:jest": "jest --config jest.integration.config.mjs --runInBand",
    "test:contract": "jest --config jest.contract.config.mjs --runInBand",
    "test:unit": "jest --config jest.unit.config.mjs --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@baas/receipt-template": "0.1.0",
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/swagger": "11.4.6",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "mysql2": "3.14.5",
    "pino": "10.3.1",
    "playwright": "1.55.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.27"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.29",
    "@swc/core": "1.15.47",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/supertest": "7.2.1",
    "jest": "30.4.2",
    "supertest": "7.2.2"
  }
}
