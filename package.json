{
  "name": "baas-console",
  "version": "0.1.0",
  "private": true,
  "description": "BaaS Console technical challenge",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,json,yml,yaml,css,html}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,json,yml,yaml,css,html}\"",
    "lint": "eslint . --max-warnings=0",
    "test:integration": "npm run test:integration --workspace @baas/api",
    "test:quality": "node --test --test-isolation=none scripts/validate-quality.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:quality": "node scripts/validate-quality.mjs",
    "verify": "node scripts/run-verification.mjs pr",
    "verify:full": "node scripts/run-verification.mjs full",
    "verify:live": "node scripts/run-verification.mjs live",
    "verify:quick": "node scripts/run-verification.mjs quick"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.9",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.3.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1"
  }
}
